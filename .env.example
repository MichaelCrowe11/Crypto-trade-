# Environment Variables for Crypto Trading App
# Copy this file to .env and update with your actual values

# Kraken API Credentials (required)
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET_KEY=your_kraken_secret_key_here

# Database Configuration
DATABASE_URL=sqlite:///crypto_trading.db

# Security
ENCRYPTION_KEY=generate_a_secure_32_byte_key_here
JWT_SECRET=your_jwt_secret_key_here

# Monitoring and Alerts (optional)
PROMETHEUS_PORT=8000
GRAFANA_URL=http://localhost:3000

# Email Alerts (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Slack Alerts (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# External Data APIs (optional)
NEWS_API_KEY=your_news_api_key
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
PAPER_TRADING=true